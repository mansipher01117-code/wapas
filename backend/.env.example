# Copy this file to .env and fill in your keys.
# Without GEMINI_API_KEY the app runs in DEMO mode (sample issues) so you can build the UI.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini Flash model your key has access to
GEMINI_MODEL=gemini-2.5-flash

# Groq key for Hinglish voice notes (Whisper): https://console.groq.com/keys
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3

# Set to 1 to force demo mode even with keys present
FORCE_DEMO=0

# Frame sampling
FRAME_INTERVAL_SEC=2
MAX_FRAMES=20

# Only when deployed: this API's public URL, so video/frame links work from the frontend
PUBLIC_BASE_URL=
# Only when deployed with a volume (Railway): keep data on the volume
# STORAGE_DIR=/data/storage
# DB_PATH=/data/wapas.db
